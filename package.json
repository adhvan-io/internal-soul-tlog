{
  "name": "internal-soul-tlog",
  "version": "1.0.0",
  "private": true,
  "description": "SWALL witness signer and STH archive",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:protocol": "tsc && node --test dist/protocol/validate.test.js",
    "test:crypto": "tsc && node --test dist/crypto/*.test.js",
    "test:api-client": "tsc && node --test dist/api-client/client.test.js",
    "test:archive": "tsc && node --test dist/archive/*.test.js",
    "test:witness-ts": "tsc && node --test dist/witness/*.test.js dist/cli/*.test.js",
    "run:witness-ts": "node dist/cli/sign-sth.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "json-canonicalize": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
